        <mxCell id="legend" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" value="&lt;b&gt;LEGEND&lt;/b&gt; &amp;nbsp; Blue = Presentation &amp;nbsp; Green = Application &amp;nbsp; Purple = Database &amp;nbsp; Grey = External services &amp;nbsp; Yellow = Security / Quality &amp;nbsp; Solid arrows = API / data flow &amp;nbsp; Dashed arrows = External integration / callback" vertex="1">
          <mxGeometry height="30" width="1510" x="85" y="1140" as="geometry" />
        </mxCell>
